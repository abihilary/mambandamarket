<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up draw the starting window themselves and ignore
     windowBackground, so without this the system splash keeps its own default
     (the theme background and the launcher icon) and the flash comes back on
     exactly the devices most people have. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
