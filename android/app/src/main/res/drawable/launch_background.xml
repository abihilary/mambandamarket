<?xml version="1.0" encoding="utf-8"?>
<!-- The window Android paints before Flutter has drawn a frame.
     It was @android:color/white, so every cold start flashed white and then
     jumped to the app's own splash. This is the same ground and the same mark
     the Flutter splash draws, so there is nothing to see between them. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_ground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
