<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access. Flutter injects this into the debug/profile manifests
         automatically, but NOT the main one, so a release build without this
         line ships with no internet at all — every API and Supabase call fails
         silently. Must be declared here for release. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Camera Permission -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Gallery access on Android 12 and below, where picking an image still
         goes through a document intent. Capped at API 32 on purpose: from 13
         the photo picker replaces it and asks for nothing.

         There is deliberately no READ_MEDIA_IMAGES beside it. image_picker
         uses the Android photo picker, which grants access to the individual
         images somebody chooses and needs no permission to do it — the plugin
         declares none itself, and every call here is a plain pickImage or
         pickMultiImage. Declaring the permission anyway granted nothing the
         app uses, and cost a Play policy declaration defending access it
         never takes. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Approximate location, so a buyer can be told how far away something is.

         COARSE only, and FINE is actively removed below rather than merely
         left out: geolocator_android declares FINE in its own manifest, and
         manifest merging is a union — without the tools:node="remove" the
         release APK would ask for precise location no matter what this file
         says. A precise point on a private seller's listing is their doorstep,
         and a handful of distance readings trilaterate it.

         There is no ACCESS_BACKGROUND_LOCATION and there never should be: the
         app asks where you are only while you are looking at it, which also
         keeps this out of Play's background-location review entirely. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!-- Push. Android 13+ will not show a notification until the user has been
         asked; PushService raises that prompt, and without this declaration the
         prompt cannot be raised at all. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Mambanda Market"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- OAuth callback: Supabase redirects here after Google consent so
                 the app can pick the session back up. Must match the redirect
                 URL allow-listed in Supabase Auth (see kOAuthRedirect). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.mabanda.mambandamarket"
                      android:host="login-callback"/>
                <!-- Password-recovery links land here; the app swaps the
                     recovery session for a new password. -->
                <data android:scheme="com.mabanda.mambandamarket"
                      android:host="password-reset"/>
            </intent-filter>
            <!-- Shared listing links. A separate filter from the one above on
                 purpose: autoVerify applies to the whole filter, and mixing a
                 custom scheme into it makes Android refuse to verify the
                 domain at all. Verification fetches
                 /.well-known/assetlinks.json from each host below and checks
                 the release signing certificate against it, so a build signed
                 with a different key falls back to the browser rather than
                 opening here.

                 Three hosts, and all three stay. mambandamarket.com is where
                 links are minted now; the blacksilvergroups address is where
                 every link shared before the move still points, and those are
                 sitting in people's chat histories rather than expiring. A
                 host removed here is a link that silently stops opening the
                 app — so hosts are added and not replaced.

                 Verification is all-or-nothing across the filter: if any
                 host fails to serve a matching assetlinks.json, Android
                 verifies none of them — which is why www is deliberately
                 absent. It has no certificate and serves nothing, and listing
                 it here would take the two working hosts down with it. Add it
                 once it resolves, not before. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="mambandamarket.com"
                      android:pathPrefix="/l/"/>
                <data android:scheme="https"
                      android:host="mambandamarket.blacksilvergroups.xyz"
                      android:pathPrefix="/l/"/>
            </intent-filter>
        </activity>
        <!-- Push: the channel and icon the system uses for a notification that
             arrives while the app is not running, which is when FCM — not our
             code — is what puts it in the shade. 'messages' is created at
             startup by PushService; a notification addressed to a channel that
             does not exist is dropped silently by Android 8+. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>